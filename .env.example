# Copy to .env and fill in. Only needed for the OpenHands engine (the default).
# Get a key from https://app.all-hands.dev (Settings > API). Any LiteLLM model works.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://llm-proxy.app.all-hands.dev
LLM_MODEL=litellm_proxy/claude-sonnet-4-6
LLM_MODEL_SUB=litellm_proxy/claude-haiku-4-5-20251001
